{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/unity/Build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    }
  ]
}
